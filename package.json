{
  "name": "tebu-opis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "NUXT_PUBLIC_DEMO=true nuxt generate",
    "start": "node .output/server/index.mjs",
    "postinstall": "prisma generate && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:schedules": "prisma db seed -- --schedules-only",
    "db:studio": "prisma studio",
    "test:database": "node tests/database.mjs"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "lucide-vue-next": "1.0.0",
    "nuxt": "3.21.11",
    "pg": "^8.23.1",
    "reka-ui": "2.11.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^2.6.0",
    "vaul-vue": "0.4.1",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.21",
    "@types/pg": "^8.23.1",
    "playwright": "1.62.0",
    "prisma": "7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  }
}
