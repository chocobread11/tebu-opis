generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String?  @unique(map: "customers_phone_unique")
  name      String
  tokenHash String   @unique(map: "customers_token_hash_unique") @map("token_hash")
  passwordHash String? @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders    Order[]
  sessions  CustomerSession[]
  checkouts CheckoutSession[]
  recoveries PasswordRecovery[]

  @@map("customers")
}

model CustomerSession {
  tokenHash  String   @id @map("token_hash")
  customerId String  @map("customer_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_sessions")
}

model CheckoutSession {
  tokenHash String @id @map("token_hash")
  customerId String @map("customer_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([customerId])
  @@map("checkout_sessions")
}

model Schedule {
  id           String    @id
  // Shared spaces: Kecik uses 1, Besar uses 2. Size fields are derived compatibility values.
  capacity     Int       @default(12)
  kecikCapacity Int      @default(12) @map("kecik_capacity")
  besarCapacity Int        @default(6) @map("besar_capacity")
  open         Boolean   @default(true)
  photoId      String?   @map("photo_id") @db.Uuid
  droppedAt    DateTime? @map("dropped_at") @db.Timestamptz(6)
  closedReason String?   @map("closed_reason")
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  orders       Order[]
  media        Media[]
  photo        Media?    @relation("PublishedPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  expenses     Expense[]
  harvests     Harvest[]

  @@map("schedules")
}

model Order {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String       @unique(map: "orders_token_unique")
  requestId   String       @unique(map: "orders_request_id_unique") @map("request_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  scheduleId  String       @map("schedule_id")
  sequence    Int
  tag         String       @default(dbgenerated("next_order_tag()"))
  cart        Json         @db.JsonB
  bottles     Int
  total       Int
  // Kept as text to preserve the existing database; allowed values are checked in SQL.
  status      String       @default("pending_payment")
  manualPaymentStatus String? @map("manual_payment_status")
  customerName String? @map("customer_name")
  remarks     String?      @db.Text
  checkoutSessionHash String? @map("checkout_session_hash")
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionHash], references: [tokenHash], onDelete: SetNull)
  receiptId   String?      @map("receipt_id") @db.Uuid
  packed      Boolean      @default(false)
  notified    Boolean      @default(false)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_customer_id_customers_id_fk")
  schedule    Schedule     @relation(fields: [scheduleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_schedule_id_schedules_id_fk")
  media       Media[]
  receipt     Media?       @relation("SubmittedReceipt", fields: [receiptId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  fulfilled Boolean @default(false)
  refundedTotal Int @default(0) @map("refunded_total")
  cancellationReason String? @map("cancellation_reason")
  refunds Refund[]
  varietyId   String?      @map("variety_id")
  varietyName String?      @map("variety_name")
  variety     CaneVariety? @relation(fields: [varietyId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, sequence], map: "schedule_sequence")
  @@map("orders")
}

model Media {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename           String
  kind               String
  orderId            String?    @map("order_id") @db.Uuid
  scheduleId         String?    @map("schedule_id")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  order              Order?     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_order_id_orders_id_fk")
  schedule           Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_schedule_id_schedules_id_fk")
  publishedSchedules Schedule[] @relation("PublishedPhoto")
  submittedOrders    Order[]    @relation("SubmittedReceipt")

  productId String? @map("product_id")
  product Product? @relation("ProductUploads", fields: [productId], references: [id], onDelete: SetNull)
  publishedProducts Product[] @relation("ProductImage")

  @@map("media")
}

model Product {
  id          String      @id
  name        String
  size        String
  description String
  kind        String
  price       Int
  active      Boolean     @default(true)
  sortOrder   Int         @default(0) @map("sort_order")
  items       OrderItem[]

  spaceCost Int @default(1) @map("space_cost")
  trackStock Boolean @default(true) @map("track_stock")
  varietyTracked Boolean @default(false) @map("variety_tracked")
  imageId String? @map("image_id") @db.Uuid
  image Media? @relation("ProductImage", fields: [imageId], references: [id], onDelete: SetNull)
  uploads Media[] @relation("ProductUploads")
  stockEntries StockEntry[]

  @@map("products")
}

model OrderItem {
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id")
  quantity  Int
  unitPrice Int     @map("unit_price")
  name String?
  size String?
  kind String?
  spaceCost Int @default(0) @map("space_cost")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
  @@map("order_items")
}

model Expense {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime  @db.Date
  amount     Int
  note       String    @default("")
  scheduleId String?   @map("schedule_id")
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([date])
  @@index([scheduleId])
  @@map("expenses")
}

model Harvest {
  stockEntries StockEntry[]
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime     @db.Date
  type       String
  quantity   Decimal      @db.Decimal(10, 2)
  varietyId  String?      @map("variety_id")
  variety    CaneVariety? @relation(fields: [varietyId], references: [id], onDelete: Restrict)
  kecikQty   Int          @default(0) @map("kecik_qty")
  besarQty     Int          @default(0) @map("besar_qty")
  scheduleId String?      @map("schedule_id")
  schedule   Schedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([date])
  @@index([scheduleId])
  @@index([varietyId])
  @@map("harvests")
}

model CaneVariety {
  id          String    @id
  name        String
  description String    @default("")
  sortOrder   Int       @default(0) @map("sort_order")
  harvests    Harvest[]
  orders      Order[]
  stockEntries StockEntry[]

  @@map("cane_varieties")
}

model StockEntry {
  kind String @default("restock")
  sourceHarvestId String? @map("source_harvest_id") @db.Uuid
  sourceHarvest Harvest? @relation(fields: [sourceHarvestId], references: [id], onDelete: Restrict)
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id")
  varietyId String? @map("variety_id")
  date DateTime @db.Date
  quantity Int
  note String @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variety CaneVariety? @relation(fields: [varietyId], references: [id], onDelete: Restrict)

  @@unique([sourceHarvestId, productId])
  @@index([productId, varietyId])
  @@map("stock_entries")
}

model ShopSettings {
  merchantName String? @map("merchant_name")
  supportWhatsapp String? @map("support_whatsapp")
  siteUrl String? @map("site_url")
  telegramEnabled Boolean? @map("telegram_enabled")
  telegramChatId String? @map("telegram_chat_id")
  id String @id @default("main")
  whatsappOpening String @map("whatsapp_opening") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("shop_settings")
}

model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  action String
  actor String @default("admin")
  before Json? @db.JsonB
  after Json? @db.JsonB
  note String @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}
model Refund {
  requestId String @unique @default(dbgenerated("gen_random_uuid()")) @map("request_id") @db.Uuid
  cancelOrder Boolean @default(false) @map("cancel_order")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  amount Int
  reason String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@map("refunds")
}
model PasswordRecovery {
  tokenHash String @id @map("token_hash")
  customerId String @map("customer_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId])
  @@map("password_recoveries")
}

// Keep the creation snapshot even if an unpaid order is later removed.
model TelegramNotification {
  orderId String @map("order_id") @db.Uuid
  event String @default("created")
  message String @db.Text
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  messageId Int? @map("message_id")
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([orderId, event])
  @@index([sentAt, nextAttemptAt])
  @@map("telegram_notifications")
}

model AdminSession {
  tokenHash String @id @map("token_hash")
  keyHash String @map("key_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([expiresAt])
  @@map("admin_sessions")
}
