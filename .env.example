NUXT_PUBLIC_DEMO=false
NUXT_DATABASE_URL=postgres://tebu:replace-me@postgres:5432/tebu
NUXT_ADMIN_KEY=replace-with-at-least-32-random-characters
NUXT_UPLOAD_DIR=/app/data/uploads
NUXT_PUBLIC_DUITNOW_QR=
NUXT_PUBLIC_MERCHANT_NAME=Tebu Drop
# Initial website origin fallback; later changes can be saved in Admin Settings.
# Also overrides automatic origin detection for phone receipt links.
NUXT_SITE_URL=
# Customer dispute/help link. Malaysian number including country code, without +.
NUXT_PUBLIC_SUPPORT_WHATSAPP=

# Upload storage: keep local until credentials are filled, then change to r2.
NUXT_UPLOAD_STORAGE=local
NUXT_R2_ACCOUNT_ID=""
# Optional S3 API origin (https://<account>.r2.cloudflarestorage.com), without the bucket path.
# Otherwise derived from the account ID. Put only the bucket name in NUXT_R2_BUCKET.
NUXT_R2_ENDPOINT=
NUXT_R2_ACCESS_KEY_ID=""
NUXT_R2_SECRET_ACCESS_KEY=""
NUXT_R2_BUCKET=""
NUXT_R2_PREFIX=

# Optional: Telegram receipt alerts. Token stays here; chat ID/on-off are editable in Settings.
# Server-only credentials. Create a bot with @BotFather and start its private chat.
NUXT_TELEGRAM_BOT_TOKEN=
# Initial chat ID fallback, used until saved in Settings.
NUXT_TELEGRAM_CHAT_ID=

# Development defaults. Production uses .env.production.example and rejects test/LAN settings.
NUXT_DEPLOYMENT_MODE=development
NUXT_TRUST_PROXY=false
# Required for encrypted backups; save this key separately from backup files.
TEBU_BACKUP_ENCRYPTION_KEY=
TEBU_BACKUP_DIRECTORY=./data/backups
TEBU_BACKUP_KEEP=14
TEBU_BACKUP_INTERVAL_SECONDS=86400
