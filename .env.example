NUXT_PUBLIC_DEMO=false
NUXT_DATABASE_URL=postgres://tebu:replace-me@postgres:5432/tebu
NUXT_ADMIN_KEY=replace-with-at-least-32-random-characters
NUXT_UPLOAD_DIR=/app/data/uploads
NUXT_PUBLIC_DUITNOW_QR=/qr/duitnow.jpeg
NUXT_PUBLIC_MERCHANT_NAME=Tebu Drop

# Upload storage: keep local until credentials are filled, then change to r2.
NUXT_UPLOAD_STORAGE=local
NUXT_R2_ACCOUNT_ID=
# Optional explicit S3 API endpoint; otherwise derived from the account ID.
NUXT_R2_ENDPOINT=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=
NUXT_R2_PREFIX=tebu/media
