# Copy to ignored .env.production and fill every required value before deployment.
NODE_ENV=production
NUXT_DEPLOYMENT_MODE=production
NUXT_PUBLIC_DEMO=false
NUXT_PUBLIC_TESTING_CALENDAR=false
NUXT_TRUST_PROXY=true
POSTGRES_PASSWORD=replace-with-a-long-random-password
NUXT_DATABASE_URL=postgresql://tebu:replace-with-a-long-random-password@postgres:5432/tebu
NUXT_ADMIN_KEY=replace-with-at-least-32-random-characters
# Your actual public HTTPS origin, without the internal :3000 routing suffix.
NUXT_SITE_URL=
NUXT_PUBLIC_MERCHANT_NAME=Tebu Drop
NUXT_PUBLIC_SUPPORT_WHATSAPP=
NUXT_PUBLIC_DUITNOW_QR=/qr/duitnow.jpeg
NUXT_UPLOAD_STORAGE=r2
NUXT_UPLOAD_DIR=/app/data/uploads
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ENDPOINT=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=
NUXT_R2_PREFIX=tebu/media
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
# Generate with: openssl rand -base64 32. Save separately; backups require this key to restore.
TEBU_BACKUP_ENCRYPTION_KEY=
TEBU_BACKUP_DIRECTORY=/backups
TEBU_BACKUP_KEEP=14
TEBU_BACKUP_INTERVAL_SECONDS=86400
